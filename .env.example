# Local: copy this to .env. Generate your own random key before deployment.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///queensway.db
# Blank contact details are hidden until configured. Do not invent contact information.
SCHOOL_EMAIL=
SCHOOL_PHONE=
SCHOOL_ADDRESS=
SCHOOL_HOURS=
# Shared Redis rate-limit storage is recommended for production/multiple workers.
REDIS_URL=memory://
# Set only to the verified number of trusted reverse proxies in front of Flask.
TRUSTED_PROXY_HOPS=0
# Enable debug only on your own development machine.
FLASK_DEBUG=0
